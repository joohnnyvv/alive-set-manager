{
  "name": "alive-set-manager",
  "version": "0.1.0-alpha.1",
  "main": "dist/src/electron/main.js",
  "type": "module",
  "scripts": {
    "dev:backend": "tsx watch src/index.ts",
    "test": "node scripts/test.mjs",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "vite build",
    "build": "npm run prepare:resources && npm run build:backend && npm run build:frontend",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "app:start": "electron .",
    "pack:mac": "npm run build && electron-builder --mac dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "install:mac": "bash scripts/install-mac.sh",
    "prepare:resources": "node node_modules/electron/install.js && node scripts/prepare-resources.mjs",
    "licenses:check": "npm run prepare:resources -- --check",
    "demo": "tsx src/testing/server.ts",
    "test:e2e": "playwright test",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "pack:win": "npm run build && electron-builder --win dir --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "release:validate": "node scripts/release.mjs validate"
  },
  "build": {
    "appId": "io.github.joohnnyvv.alivesetmanager",
    "productName": "Alive Set Manager",
    "artifactName": "Alive-Set-Manager-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-app",
      "buildResources": "resources"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/src/**/*",
      "!dist/src/**/*.test.js",
      "!dist/src/testing/server.js",
      "frontend/dist/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/test{,s}/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "AbletonJS/**/*",
          "THIRD_PARTY_NOTICES.txt",
          "sbom.json",
          "icon.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "keywords": [],
  "author": "joohnnyvv",
  "license": "ISC",
  "description": "Stage-ready Ableton Live setlist controller",
  "dependencies": {
    "ableton-js": "^4.1.0",
    "cors": "^2.8.6",
    "easymidi": "^3.2.0",
    "express": "^5.2.1",
    "qr-code-styling": "^1.9.2",
    "semver": "7.8.5",
    "solid-js": "^1.9.14",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/semver": "7.8.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.5",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joohnnyvv/alive-set-manager.git"
  },
  "homepage": "https://github.com/joohnnyvv/alive-set-manager",
  "bugs": {
    "url": "https://github.com/joohnnyvv/alive-set-manager/issues"
  },
  "overrides": {
    "ableton-js": {
      "uuid": "11.1.1"
    }
  }
}
