{
  "name": "alive-set-manager",
  "version": "1.0.0",
  "main": "dist/src/electron/main.js",
  "type": "module",
  "scripts": {
    "dev:backend": "tsx watch src/index.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "dev:frontend": "vite frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck": "tsc --noEmit",
    "app:start": "electron .",
    "pack:mac": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "install:mac": "bash scripts/install-mac.sh"
  },
  "build": {
    "appId": "com.ableset.controller",
    "productName": "Alive Set Manager",
    "directories": {
      "output": "dist-app"
    },
    "asar": true,
    "asarUnpack": [
      "frontend/dist/**/*",
      "dist/**/*"
    ],
    "files": [
      "dist/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AbleSet Clone - Ableton Live setlist controller",
  "dependencies": {
    "ableton-js": "^4.1.0",
    "cors": "^2.8.6",
    "easymidi": "^3.2.0",
    "express": "^5.2.1",
    "qr-code-styling": "^1.9.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
