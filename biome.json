{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**",
      "frontend/src/**",
      "scripts/**",
      "tests/**",
      "*.ts",
      "*.mjs",
      "*.cjs",
      "biome.json",
      "package.json",
      "tsconfig*.json",
      "frontend/tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": { "preset": "recommended" },
      "suspicious": { "preset": "recommended", "noExplicitAny": "off" }
    },
    "domains": { "react": "none", "solid": "recommended" }
  }
}
